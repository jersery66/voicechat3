# Safe operator variable template. This repository does not automatically load
# a .env file; explicitly export/set these variables before launch (or use an
# external environment loader). Never commit credentials, personal paths, or
# participant data.

# Runtime configuration selection. The named YAML file describes every
# model, endpoint, provider, and generation parameter; switching
# hardware, models, or the inference engine is an edit of that file, not
# a code change. Leave empty to use the repository default
# (config/runtime.yaml).
VOICECHAT_RUNTIME_CONFIG=

# Portable model/data roots. Adjust locally on the target workstation.
VOICECHAT_MODELS_DIR=./models
VOICECHAT_DATA_DIR=./runtime/data
FUNASR_MODEL_PATH=
VOXCPM_MODEL_PATH=
VOICE_PROMPT_PATH=
VOICE_PROMPT_TEXT=

# FSMN-VAD is intentionally isolated from dialogue/STT/TTS GPU placement.
FSMN_VAD_DEVICE=cpu

# WSL service runtime directory; this value is interpreted inside WSL.
VOICECHAT_VLLM_RUNTIME_DIR=~/.voicechat/vllm

# Loopback-only diagnostics.
NO_PROXY=localhost,127.0.0.1

# Do not set model/endpoint override variables when the runtime
# configuration declares an immutable contract (runtime.immutable_contract:
# true). They are ignored in that case.
# OLLAMA_MODEL=
# AGENT_MODEL=
# VOICECHAT_DIALOGUE_MODEL=
# VOICECHAT_DIALOGUE_BASE_URL=
# VOICECHAT_AGENT_BASE_URL=
