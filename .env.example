# Safe operator template. Copy values into the process environment or a local
# ignored .env file; never commit credentials, personal paths, or participant data.

# Profile-owned production selection.
VOICECHAT_DEPLOYMENT_PROFILE=rtxpro6000_96g

# Portable model/data roots. Adjust locally on the target workstation.
VOICECHAT_MODELS_DIR=./models
VOICECHAT_DATA_DIR=./runtime/data
FUNASR_MODEL_PATH=
VOXCPM_MODEL_PATH=
VOICE_PROMPT_PATH=
VOICE_PROMPT_TEXT=

# FSMN-VAD is intentionally isolated from dialogue/STT/TTS GPU placement.
FSMN_VAD_DEVICE=cpu

# WSL service runtime directory; this value is interpreted inside WSL.
VOICECHAT_VLLM_RUNTIME_DIR=~/.voicechat/vllm

# Loopback-only diagnostics.
NO_PROXY=localhost,127.0.0.1

# Do not set model/endpoint override variables for immutable production profiles.
# OLLAMA_MODEL=
# AGENT_MODEL=
# VOICECHAT_DIALOGUE_MODEL=
# VOICECHAT_VLLM_MODEL=
# VOICECHAT_DIALOGUE_BASE_URL=
# VOICECHAT_AGENT_BASE_URL=
